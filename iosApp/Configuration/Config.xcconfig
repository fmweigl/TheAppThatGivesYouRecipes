TEAM_ID=

PRODUCT_NAME=TheAppThatGivesYouRecipes
# The home screen label: the full name, "The App That Gives You Recipes", doesn't fit under the icon.
INFOPLIST_KEY_CFBundleDisplayName=TATGYR
PRODUCT_BUNDLE_IDENTIFIER=io.github.fmweigl.theappthatgivesyourecipes.TheAppThatGivesYouRecipes$(TEAM_ID)

// Defaults, overridden by the generated Version.xcconfig (./gradlew :composeApp:writeIosVersionConfig).
CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// Optional, so a fresh checkout without the generated file still builds.
#include? "Version.xcconfig"
